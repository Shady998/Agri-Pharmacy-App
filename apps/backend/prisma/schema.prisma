generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  MANAGER
  SALESPERSON
  VIEWER
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  TRIAL
  SUSPENDED
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
  CUSTOM
}

enum PesticideType {
  FUNGICIDE
  INSECTICIDE
  HERBICIDE
  OTHER
}

enum UnitType {
  KG
  BOX
  SEEDS
  LITER
  PACKET
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  RETURN
  EXPIRED
  DAMAGED
}

enum CustomerType {
  FARMER
  PRODUCER
  BOTH
}

enum DebtStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  CARD
  OTHER
}

enum SaleStatus {
  DRAFT
  COMPLETED
  RETURNED
  CANCELLED
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  MARKETING
  TRANSPORT
  MAINTENANCE
  INSURANCE
  TAXES
  OTHER
}

// ==================== CORE MODELS ====================

model Tenant {
  id            String           @id @default(uuid())
  name          String
  slug          String           @unique
  plan          SubscriptionPlan @default(STARTER)
  status        TenantStatus     @default(TRIAL)
  settings      Json             @default("{}")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  users         User[]
  products      Product[]
  inventoryBatches InventoryBatch[]
  stockMovements StockMovement[]
  customers     Customer[]
  debts         Debt[]
  debtPayments  DebtPayment[]
  sales         Sale[]
  saleItems     SaleItem[]
  expenses      Expense[]
  auditLogs     AuditLog[]

  @@index([slug])
  @@index([status])
}

model User {
  id            String     @id @default(uuid())
  clerkId       String     @unique
  tenantId      String
  role          UserRole   @default(VIEWER)
  name          String?
  email         String     @unique
  phone         String?
  avatarUrl     String?
  isActive      Boolean    @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdSales  Sale[]     @relation("SaleCreatedBy")
  updatedSales  Sale[]     @relation("SaleUpdatedBy")

  @@index([tenantId])
  @@index([clerkId])
  @@index([email])
}

// ==================== PRODUCTS & INVENTORY ====================

model Product {
  id                String        @id @default(uuid())
  tenantId          String
  tradeName         String
  activeIngredient  String
  pesticideType     PesticideType
  usageNotes        String?
  unitType          UnitType      @default(KG)
  minThreshold      Decimal       @default(0) @db.Decimal(10, 2)
  barcode           String?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryBatches  InventoryBatch[]
  stockMovements    StockMovement[]
  saleItems         SaleItem[]

  @@unique([tenantId, tradeName, activeIngredient])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, pesticideType])
}

model InventoryBatch {
  id            String   @id @default(uuid())
  productId     String
  tenantId      String
  batchNumber   String
  quantity      Decimal  @db.Decimal(10, 2)
  unitCost      Decimal  @db.Decimal(10, 2)
  expiryDate    DateTime?
  receivedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  saleItems     SaleItem[]

  @@unique([tenantId, batchNumber])
  @@index([tenantId])
  @@index([productId])
  @@index([expiryDate])
}

model StockMovement {
  id              String            @id @default(uuid())
  tenantId        String
  productId       String
  batchId         String?
  type            StockMovementType
  quantity        Decimal           @db.Decimal(10, 2)
  referenceType   String?
  referenceId     String?
  notes           String?
  createdAt       DateTime          @default(now())

  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch           InventoryBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@index([batchId])
  @@index([createdAt])
  @@index([tenantId, type])
}

// ==================== CUSTOMERS & DEBTS ====================

model Customer {
  id            String       @id @default(uuid())
  tenantId      String
  name          String
  type          CustomerType @default(FARMER)
  phone         String?
  address       String?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  debts         Debt[]
  sales         Sale[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, type])
}

model Debt {
  id            String      @id @default(uuid())
  tenantId      String
  customerId    String
  amount        Decimal     @db.Decimal(12, 2)
  status        DebtStatus  @default(PENDING)
  dueDate       DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments      DebtPayment[]
  saleId        String?     @unique
  sale          Sale?       @relation(fields: [saleId], references: [id])

  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, status])
  @@index([dueDate])
}

model DebtPayment {
  id          String        @id @default(uuid())
  debtId      String
  tenantId    String
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod @default(CASH)
  paidAt      DateTime      @default(now())
  notes       String?
  createdAt   DateTime      @default(now())

  debt        Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([debtId])
  @@index([paidAt])
}

// ==================== SALES & EXPENSES ====================

model Sale {
  id            String     @id @default(uuid())
  tenantId      String
  customerId    String?
  createdById   String
  updatedById   String?
  totalAmount   Decimal    @db.Decimal(12, 2)
  discount      Decimal    @default(0) @db.Decimal(10, 2)
  tax           Decimal    @default(0) @db.Decimal(10, 2)
  status        SaleStatus @default(DRAFT)
  saleDate      DateTime   @default(now())
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy     User       @relation("SaleCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?      @relation("SaleUpdatedBy", fields: [updatedById], references: [id])
  items         SaleItem[]
  debt          Debt?

  @@index([tenantId])
  @@index([customerId])
  @@index([saleDate])
  @@index([tenantId, status])
  @@index([tenantId, saleDate])
}

model SaleItem {
  id          String  @id @default(uuid())
  saleId      String
  tenantId    String
  productId   String
  batchId     String?
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch       InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([saleId])
  @@index([productId])
  @@index([batchId])
}

model Expense {
  id            String          @id @default(uuid())
  tenantId      String
  category      ExpenseCategory
  amount        Decimal         @db.Decimal(12, 2)
  expenseDate   DateTime
  description   String?
  receiptUrl    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([expenseDate])
  @@index([tenantId, category])
  @@index([tenantId, expenseDate])
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String?
  action      String
  entityType  String
  entityId    String
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId])
}