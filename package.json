{
  "name": "agri-pharmacy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:backend": "nx run backend:serve",
    "dev:frontend": "nx run frontend:serve",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "nx run backend:build",
    "build:frontend": "nx run frontend:build",
    "build": "nx run-many --target=build --all",
    "lint": "nx run-many --target=lint --all",
    "test": "nx run-many --target=test --all",
    "db:generate": "nx run backend:db:generate",
    "db:push": "nx run backend:db:push",
    "db:migrate": "nx run backend:db:migrate",
    "db:studio": "nx run backend:db:studio",
    "docker:up": "docker-compose -f docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker-compose.yml down",
    "docker:logs": "docker-compose -f docker-compose.yml logs -f"
  },
  "dependencies": {
    "@clerk/clerk-sdk-node": "^4.13.0",
    "@prisma/client": "^5.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^7.1.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.2.0",
    "@nestjs/testing": "^10.3.0",
    "@nx/js": "23.2.1",
    "@nx/nest": "^23.2.1",
    "@nx/react": "^23.2.1",
    "@nx/vite": "^23.2.1",
    "@nx/workspace": "23.2.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.0",
    "concurrently": "^8.2.2",
    "nx": "23.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.3.0"
  }
}